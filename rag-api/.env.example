# Graphe RDF 
TTL_PATH=../data/forest_kg.ttl

# Retrieval
RETRIEVAL_TOP_K=8

LLM_EXTRACTION_MODE=auto

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info